class Buffer {
    int data;
    boolean available = false;

    synchronized void produce(int value) throws InterruptedException {
        while (available)
            wait();

        data = value;
        System.out.println("Produced: " + data);
        available = true;
        notify();
    }

    synchronized void consume() throws InterruptedException {
        while (!available)
            wait();

        System.out.println("Consumed: " + data);
        available = false;
        notify();
    }
}

class PC {
    public static void main(String[] args) {
        Buffer b = new Buffer();

        new Thread(() -> {
            try {
                for (int i = 1; i <= 5; i++)
                    b.produce(i);
            } catch (Exception e) {}
        }).start();

        new Thread(() -> {
            try {
                for (int i = 1; i <= 5; i++)
                    b.consume();
            } catch (Exception e) {}
        }).start();
    }
}