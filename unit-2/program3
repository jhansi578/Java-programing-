// Base class (Grandparent)
class Animal {
    String name;

    void eat() {
        System.out.println(name + " is eating.");
    }

    void sleep() {
        System.out.println(name + " is sleeping.");
    }
}

// Intermediate class (Parent)
class Mammal extends Animal {
    void breathe() {
        System.out.println(name + " is breathing air.");
    }
}

// Derived class (Child)
class Dog extends Mammal {
    String breed;

    void setDogDetails(String n, String b) {
        name = n;     // inherited from Animal
        breed = b;    // Dog’s own property
    }

    void displayDogDetails() {
        System.out.println("Dog Name : " + name);
        System.out.println("Breed : " + breed);
    }

    void sound() {
        System.out.println(name + " barks: Woof Woof!");
    }
}

// Main class
public class MultiLevelInheritanceAnimal {
    public static void main(String[] args) {
        Dog dog1 = new Dog();

        // Set values
        dog1.setDogDetails("Tommy", "German Shepherd");

        // Display details
        System.out.println("----- Dog Details -----");
        dog1.displayDogDetails();

        // Using inherited methods
        dog1.eat();      // from Animal
        dog1.sleep();    // from Animal
        dog1.breathe();  // from Mammal
        dog1.sound();    // from Dog
    }
}