// Interface 1
interface Animal {
    void eat();
    void sleep();
}

// Interface 2
interface Pet {
    void play();
}

// Class implementing multiple interfaces
class Dog implements Animal, Pet {
    String name;

    Dog(String n) {
        name = n;
    }

    // Implementing Animal methods
    public void eat() {
        System.out.println(name + " is eating.");
    }

    public void sleep() {
        System.out.println(name + " is sleeping.");
    }

    // Implementing Pet method
    public void play() {
        System.out.println(name + " is playing.");
    }
}

// Main class
public class InterfaceExample {
    public static void main(String[] args) {

        Dog dog1 = new Dog("Tommy");

        dog1.eat();    // from Animal interface
        dog1.sleep();  // from Animal interface
        dog1.play();   // from Pet interface
    }
}