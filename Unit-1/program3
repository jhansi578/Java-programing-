import java.util.Arrays;
import java.util.Scanner;

public class BinarySearchExample {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Reading number of elements
        System.out.print("Enter number of elements (n): ");
        int n = sc.nextInt();

        int[] arr = new int[n];

        // Reading array elements
        System.out.println("Enter " + n + " integers:");
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        // Sorting array (Binary Search works on sorted array)
        Arrays.sort(arr);
        System.out.println("Sorted array: " + Arrays.toString(arr));

        // Reading element to search
        System.out.print("Enter element to search: ");
        int key = sc.nextInt();

        // Performing binary search
        int result = binarySearch(arr, key);

        // Display result
        if (result == -1) {
            System.out.println("Element " + key + " not found in the array.");
        } else {
            System.out.println("Element " + key + " found at position (0-based index): " + result);
        }

        sc.close();
    }

    // Binary Search Method
    public static int binarySearch(int[] arr, int key) {
        int left = 0;
        int right = arr.length - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            // Check if key is at mid
            if (arr[mid] == key) {
                return mid;
            }

            // If key is greater, search right half
            if (arr[mid] < key) {
                left = mid + 1;
            }
            // If key is smaller, search left half
            else {
                right = mid - 1;
            }
        }

        return -1; // Key not found
    }
}