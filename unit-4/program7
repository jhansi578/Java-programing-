class BinarySearch {
    static int search(int[] arr, int l, int r, int key) {
        if (l <= r) {
            int mid = (l + r) / 2;
            if (arr[mid] == key)
                return mid;
            else if (arr[mid] > key)
                return search(arr, l, mid - 1, key);
            else
                return search(arr, mid + 1, r, key);
        }
        return -1;
    }

    public static void main(String[] args) {
        int[] arr = {1, 3, 5, 7, 9};
        int key = 7;

        int res = search(arr, 0, arr.length - 1, key);
        System.out.println(res == -1 ? "Not Found" : "Found at " + res);
    }
}